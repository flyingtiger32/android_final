<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.1"
        android:id="@+id/vertical10"/>
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.9"
        android:id="@+id/vertical90"/>
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.1"
        android:id="@+id/horitzontal10"/>
    <androidx.constraintlayout.widget.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.9"
        android:id="@+id/horitzontal90"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/horitzontal10"
        app:layout_constraintStart_toStartOf="@id/vertical10"
        app:layout_constraintEnd_toEndOf="@id/vertical90"
        android:hint="Introdueixi el nom"
        android:id="@+id/tilNom">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tilNom"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/vertical10"
        app:layout_constraintEnd_toEndOf="@id/vertical90"
        android:hint="Introdueixi la descripció"
        android:id="@+id/tilDescripcio">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tilDescripcio"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/vertical10"
        app:layout_constraintEnd_toEndOf="@id/vertical90"
        android:hint="Introdueixi la categoria"
        android:id="@+id/tilCategoria">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tilCategoria"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/vertical10"
        app:layout_constraintEnd_toEndOf="@id/vertical90"
        android:hint="Introdueixi el valor"
        android:id="@+id/tilValor">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tilValor"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/vertical10"
        app:switchPadding="9dp"
        android:text="És favorit?"
        android:id="@+id/switchFav"/>
    <com.google.android.material.button.MaterialButton
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/vertical10"
        app:layout_constraintEnd_toEndOf="@id/vertical90"
        app:layout_constraintTop_toBottomOf="@id/switchFav"
        android:text="Enviar dades!"
        android:id="@+id/btnSend"/>

    <include
        layout="@layout/loading"
        android:id="@+id/loading"
        android:visibility="gone"/>
</androidx.constraintlayout.widget.ConstraintLayout>